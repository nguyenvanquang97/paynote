{
  "name": "paynote",
  "version": "0.0.1",
  "private": true,
  "packageManager": "yarn@3.6.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile:start": "yarn workspace @paynote/mobile start",
    "mobile:android": "yarn workspace @paynote/mobile android",
    "mobile:ios": "yarn workspace @paynote/mobile ios",
    "api:dev": "yarn workspace @paynote/api start:dev",
    "api:build": "yarn workspace @paynote/api build",
    "api:test": "yarn workspace @paynote/api test",
    "shared:build": "yarn workspace @paynote/shared build",
    "lint": "yarn workspace @paynote/shared lint && yarn workspace @paynote/api lint && yarn workspace @paynote/mobile lint",
    "test": "yarn workspace @paynote/shared test && yarn workspace @paynote/api test && yarn workspace @paynote/mobile test"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
